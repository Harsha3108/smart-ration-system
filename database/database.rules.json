{
  "rules": {
    ".read": true,
    ".write": true,
    "cards": {
      ".indexOn": ["rfidUid", "phone", "status", "assignedStoreId"]
    },
    "stores": {
      ".indexOn": ["storeId", "active"]
    },
    "operators": {
      ".indexOn": ["email", "storeId"]
    },
    "transactions": {
      ".indexOn": ["cardId", "rfidUid", "storeId", "distributionDate", "status"]
    }
  }
}
